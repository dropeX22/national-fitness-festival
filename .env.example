# Copia este archivo como ".env" y llena tus datos reales.
# El sistema funciona SIN llenar Yappy ni correo (usa modos simulados).

# Base de datos (por defecto SQLite local, no necesitas cambiar esto)
DATABASE_URL=sqlite:///./evento.db

# --- ACCESO AL PANEL ADMIN Y CHECK-IN ---
# Usuario y contraseña que pedirá el navegador para entrar a /admin y /checkin.
# CAMBIA ESTOS VALORES antes de subir el proyecto a internet.
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambia-esta-clave

# --- CORREO (opcional) ---
# Usa una "contraseña de aplicación" de Gmail (no tu contraseña normal).
# Si dejas esto vacío, el sistema simula el envío de correo (imprime en consola).
EMAIL_REMITENTE=
EMAIL_CLAVE_APP=

# --- YAPPY (opcional) ---
# Si dejas esto vacío, el sistema usa el MODO SIMULADO de pago (sin dinero real).
YAPPY_MERCHANT_ID=
YAPPY_SECRET_KEY=
YAPPY_API_URL=https://apipagosbg.bgeneral.com
YAPPY_WEBHOOK_URL=http://localhost:8000/webhook/yappy
